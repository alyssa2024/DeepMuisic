@misc{kingma_auto-encoding_2022,
	title = {Auto-{Encoding} {Variational} {Bayes}},
	url = {http://arxiv.org/abs/1312.6114},
	doi = {10.48550/arXiv.1312.6114},
	abstract = {How can we perform efﬁcient inference and learning in directed probabilistic models, in the presence of continuous latent variables with intractable posterior distributions, and large datasets? We introduce a stochastic variational inference and learning algorithm that scales to large datasets and, under some mild differentiability conditions, even works in the intractable case. Our contributions are two-fold. First, we show that a reparameterization of the variational lower bound yields a lower bound estimator that can be straightforwardly optimized using standard stochastic gradient methods. Second, we show that for i.i.d. datasets with continuous latent variables per datapoint, posterior inference can be made especially efﬁcient by ﬁtting an approximate inference model (also called a recognition model) to the intractable posterior using the proposed lower bound estimator. Theoretical advantages are reﬂected in experimental results.},
	language = {en},
	urldate = {2026-08-03},
	publisher = {arXiv},
	author = {Kingma, Diederik P. and Welling, Max},
	month = dec,
	year = {2022},
	note = {arXiv:1312.6114 [stat.ML]},
	keywords = {Computer Science - Machine Learning, Statistics - Machine Learning},
	file = {PDF:files/1571/Kingma和Welling - 2022 - Auto-Encoding Variational Bayes.pdf:application/pdf},
}

@article{li_robust_nodate,
	title = {{ROBUST} {MVDR} {BEAMFORMING} {METHOD} {FOR} {NON}-{UNIFORM} {PROBE} {CONFIGURATIONS} {AND} {ITS} {APPLICATION} {IN} {BLADE} {RESONANCE} {PARAMETER} {IDENTIFICATION}},
	abstract = {Blades are critical components in rotating machinery, so monitoring their operational vibration is essential for ensuring safe and stable performance. Blade tip timing (BTT), as a promising non-contact measurement technique, enables the monitoring of vibrational states across all blades during inservice operation. However, the inherently under-sampled vibration data obtained from BTT poses significant challenges for accurate extraction of blade vibration parameters. For BTT signals acquired using circumferential arrays of BTT probes, conventional beamforming-based methods fail to reliably extract resonance information. To address this limitation, this paper proposes a power-optimized beamforming approach and provides the interpretation of the amplitude semantics within the beamforming process. Furthermore, an active discrete-signalfeature exploitation method is introduced for blade resonance parameter identification, achieving precise estimation of resonance frequencies and amplitudes. Numerical simulations demonstrate that the proposed method exhibits markedly superior noise robustness compared with traditional approaches. Even under 0 dB signal-to-noise ratio (SNR) condition, both frequency and amplitude information can be accurately recovered. The effectiveness of the proposed methodology is ultimately validated through experimental testing on a BTT test rig.},
	language = {en},
	author = {Li, Hongkun and Yuan, Mingyang and Chen, Yugang and Liu, Yan},
	file = {PDF:files/1579/Li 等 - ROBUST MVDR BEAMFORMING METHOD FOR NON-UNIFORM PROBE CONFIGURATIONS AND ITS APPLICATION IN BLADE RES.pdf:application/pdf},
}


@article{yuan_resonance_2026,
	title = {Resonance frequency extraction in blade tip timing systems: {An} improved {MVDR} beamforming method for severe non-uniform under-sampled conditions},
	volume = {258},
	issn = {0263-2241},
	url = {https://www.sciencedirect.com/science/article/pii/S0263224125026521},
	doi = {https://doi.org/10.1016/j.measurement.2025.119293},
	abstract = {The moving blades are the core components of rotating machinery, and it is of great significance to identify the vibration parameters of blades during operation. Blade tip timing (BTT) is considered to be an effective blade vibration test method, which can effectively monitor the vibration of all blades. However, the extremely under-sampled data obtained via BTT method poses a great challenge to vibration parameter identification. The existing resonance frequency identification method has certain requirements for prior information, which causes limitations in practical applications. In this paper, the principle of the minimum variance distortionless response (MVDR) beamforming method is introduced into the blade resonance frequency identification problem, and an improved MVDR beamforming (called Improved-MVDR) method is proposed. Based on the traditional method, the covariance matrix power optimization processing method is adopted to effectively improve the anti-spectral aliasing ability and reduce the influence of interference signals on the identification results. Combined with the energy consistency-based frequency determination method, frequency identification robustness under non-stationary noisy conditions is enhanced. The proposed Improved-MVDR method not only performs well in robustness, but also is more accurate in identifying spectral peaks and has fewer pseudo peaks. Simulation and experimental verification demonstrate the effectiveness and superiority of the proposed method. The results show that the Improved-MVDR method can realize the identification of blade resonance frequency without prior knowledge.},
	journal = {Measurement},
	author = {Yuan, Mingyang and Li, Hongkun and Wang, Chuang and Shan, Kun and Zhang, Yuhang},
	year = {2026},
	keywords = {Beamforming, Blade tip timing, Frequency identification, Power optimization, Spectral aliasing},
	pages = {119293},
}


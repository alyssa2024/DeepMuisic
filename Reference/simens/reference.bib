@article{jin_deep_2026,
	title = {A deep learning-based off-grid frequency estimation method for blade tip timing signal},
	volume = {172},
	issn = {1270-9638},
	url = {https://www.sciencedirect.com/science/article/pii/S1270963826001173},
	doi = {10.1016/j.ast.2026.111736},
	abstract = {As critical components of rotating machinery, blade condition monitoring is of great significance. Blade Tip Timing (BTT) is an ideal technique for achieving online monitoring of blades. High-precision reconstruction of blade vibration parameters from BTT signals remains one of the key research challenges in the BTT field. In this study, for the first time, a deep learning approach is introduced for frequency estimation in BTT signals. Specifically, the continuous spectrum is discretized into independent grids, transforming frequency estimation into a multi-label classification problem. A neural network, incorporating matched filtering and super-resolution reconstruction modules, is trained on simulation data under a given layout to estimate potential frequencies from the covariance matrix of BTT signals. The proposed method does not require prior knowledge of the number of sources and is highly flexible, adapting to BTT data with arbitrary layouts. Furthermore, because neural network training necessitates spectrum discretization and the network output lacks signal amplitude information, Sparse Bayesian Inference (SBI) is introduced to mitigate grid errors and enhance parameter reconstruction accuracy. Finally, simulations and experiments validate the superiority of the ResFreq+SBI algorithm. Compared to other methods, ResFreq+SBI achieves a balance between estimation accuracy, resolution, and robustness while maintaining low computational complexity.},
	urldate = {2026-04-06},
	journal = {Aerospace Science and Technology},
	author = {Jin, Ruochen and Yang, Laihao and Yang, Zhibo and Feng, Junnan and Zhang, Huan and Yang, Zhijun and Chen, Xuefeng},
	month = may,
	year = {2026},
	keywords = {Deep learning, Blade tip timing (BTT), Frequency estimation, Off-grid},
	pages = {111736},
	file = {ScienceDirect Snapshot:files/1486/S1270963826001173.html:text/html},
}

@article{zachariah_line_2013,
	title = {Line spectrum estimation with probabilistic priors},
	volume = {93},
	issn = {0165-1684},
	url = {https://www.sciencedirect.com/science/article/pii/S0165168413001308},
	doi = {10.1016/j.sigpro.2013.03.038},
	abstract = {For line spectrum estimation, we derive the maximum a posteriori probability estimator where prior knowledge of frequencies is modeled probabilistically. Since the spectrum is periodic, an appropriate distribution is the circular von Mises distribution that can parameterize the entire range of prior certainty of the frequencies. An efficient alternating projections method is used to solve the resulting optimization problem. The estimator is evaluated numerically and compared with other estimators and the Cramér-Rao bound.},
	number = {11},
	urldate = {2026-04-07},
	journal = {Signal Processing},
	author = {Zachariah, Dave and Wirfält, Petter and Jansson, Magnus and Chatterjee, Saikat},
	month = nov,
	year = {2013},
	keywords = {Frequency estimation, Alternating projections method, Circular distributions, Line spectrum, Maximum a posteriori probability},
	pages = {2969--2974},
	file = {ScienceDirect Full Text PDF:files/1489/Zachariah 等 - 2013 - Line spectrum estimation with probabilistic priors.pdf:application/pdf;ScienceDirect Snapshot:files/1488/S0165168413001308.html:text/html},
}

@misc{torres_unsupervised_2024,
	title = {Unsupervised {Harmonic} {Parameter} {Estimation} {Using} {Differentiable} {DSP} and {Spectral} {Optimal} {Transport}},
	url = {http://arxiv.org/abs/2312.14507},
	doi = {10.48550/arXiv.2312.14507},
	abstract = {In neural audio signal processing, pitch conditioning has been used to enhance the performance of synthesizers. However, jointly training pitch estimators and synthesizers is a challenge when using standard audio-to-audio reconstruction loss, leading to reliance on external pitch trackers. To address this issue, we propose using a spectral loss function inspired by optimal transportation theory that minimizes the displacement of spectral energy. We validate this approach through an unsupervised autoencoding task that fits a harmonic template to harmonic signals. We jointly estimate the fundamental frequency and amplitudes of harmonics using a lightweight encoder and reconstruct the signals using a differentiable harmonic synthesizer. The proposed approach offers a promising direction for improving unsupervised parameter estimation in neural audio applications.},
	urldate = {2026-04-25},
	publisher = {arXiv},
	author = {Torres, Bernardo and Peeters, Geoffroy and Richard, Gaël},
	month = jan,
	year = {2024},
	note = {arXiv:2312.14507 [cs]},
	keywords = {Computer Science - Machine Learning, Electrical Engineering and Systems Science - Signal Processing, Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing},
	file = {Full Text PDF:files/1492/Torres 等 - 2024 - Unsupervised Harmonic Parameter Estimation Using Differentiable DSP and Spectral Optimal Transport.pdf:application/pdf;Snapshot:files/1493/2312.html:text/html},
}

@article{zhang_enhanced_2025,
	title = {Enhanced {Multidimensional} {Harmonic} {Retrieval} in {MIMO} {Wireless} {Channel} {Sounding}},
	volume = {12},
	issn = {2327-4662},
	url = {https://ieeexplore.ieee.org/document/10845166},
	doi = {10.1109/JIOT.2025.3531641},
	abstract = {This article introduces a recursive parallel dynamic mode decomposition (RPDMD) scheme tailored for multidimensional harmonic retrieval (MHR), specifically applied to MIMO wireless channel sounding. The RPDMD algorithm is devised to address the complexities inherent in multidimensional scenarios, leveraging the dynamic mode decomposition (DMD) framework within a recursive parallel structure. Initially, the observed tensorial multidimensional harmonic data is transformed into a 2-D matrix format along the rth dimension. Subsequently, DMD dissects this matrix data into eigenvalues and their associated modes. The real and imaginary components of the DMD eigenvalues yield damping factors and frequencies in the rth dimension, respectively. Furthermore, recursive DMD is employed to scrutinize each mode independently for parameter retrieval across the remaining dimensions, enabling parallel analysis. Ultimately, this high-dimensional correlated decomposition scheme delivers paired damping factors and frequencies for all tones. Notably, the proposed approach can ascertain the number of tones in undamped sinusoidal signals, making it particularly suitable for MHR even without prior knowledge of the source count. Numerical experiments demonstrate the accuracy and robustness of the RPDMD scheme, with comparative analysis indicating that RPDMD outperforms similar methods, achieving optimal results with minimal mean square error in high signal-to-noise ratio scenarios. This work presents an effective data-driven solution for the MHR problem in MIMO wireless channel sounding.},
	number = {11},
	urldate = {2026-04-26},
	journal = {IEEE Internet of Things Journal},
	author = {Zhang, Yanming and Xu, Wenchao and Jin, A-Long and Tang, Tianquan and Li, Min and Ma, Peifeng and Jiang, Lijun and Gao, Steven},
	month = jun,
	year = {2025},
	keywords = {Wireless communication, Estimation, Channel sounding, Damping, Eigenvalues and eigenfunctions, Harmonic analysis, Heuristic algorithms, Matrix decomposition, multidimensional harmonic retrieval (MHR), pair-matching problem, Power system dynamics, recursive parallel dynamic mode decomposition (RPDMD), Signal processing algorithms, Tensors, unknown number of tones},
	pages = {16243--16255},
	file = {Full Text PDF:files/1495/Zhang 等 - 2025 - Enhanced Multidimensional Harmonic Retrieval in MIMO Wireless Channel Sounding.pdf:application/pdf},
}

@misc{jiang_model-based_2022,
	title = {Model-{Based} {Neural} {Network} and {Its} {Application} to {Line} {Spectral} {Estimation}},
	url = {http://arxiv.org/abs/2202.06485},
	doi = {10.48550/arXiv.2202.06485},
	abstract = {This paper presents the concept of "model-based neural network"(MNN), which is inspired by the classic artificial neural network (ANN) but for different usages. Instead of being used as a data-driven classifier, a MNN serves as a modeling tool with artfully defined inputs, outputs, and activation functions which have explicit physical meanings. Owing to the same layered form as an ANN, a MNN can also be optimized using the back-propagation (BP) algorithm. As an interesting application, the classic problem of line spectral estimation can be modeled by a MNN. We propose to first initialize the MNN by the fast Fourier transform (FFT) based spectral estimation, and then optimize the MNN by the BP algorithm, which automatically yields the maximum likelihood (ML) parameter estimation of the frequency spectrum. We also design a method of merging and pruning the hidden-layer nodes of the MNN, which can be used for model-order selection, i.e., to estimate the number of sinusoids. Numerical simulations verify the effectiveness of the proposed method.},
	urldate = {2026-04-29},
	publisher = {arXiv},
	author = {Jiang, Yi and Zhang, Tianyi and Zhang, Wei},
	month = feb,
	year = {2022},
	note = {arXiv:2202.06485 [eess]},
	keywords = {Electrical Engineering and Systems Science - Signal Processing},
}

@misc{izacard_data-driven_2021,
	title = {Data-driven {Estimation} of {Sinusoid} {Frequencies}},
	url = {http://arxiv.org/abs/1906.00823},
	doi = {10.48550/arXiv.1906.00823},
	abstract = {Frequency estimation is a fundamental problem in signal processing, with applications in radar imaging, underwater acoustics, seismic imaging, and spectroscopy. The goal is to estimate the frequency of each component in a multisinusoidal signal from a finite number of noisy samples. A recent machine-learning approach uses a neural network to output a learned representation with local maxima at the position of the frequency estimates. In this work, we propose a novel neural-network architecture that produces a significantly more accurate representation, and combine it with an additional neural-network module trained to detect the number of frequencies. This yields a fast, fully-automatic method for frequency estimation that achieves state-of-the-art results. In particular, it outperforms existing techniques by a substantial margin at medium-to-high noise levels.},
	urldate = {2026-04-29},
	publisher = {arXiv},
	author = {Izacard, Gautier and Mohan, Sreyas and Fernandez-Granda, Carlos},
	month = feb,
	year = {2021},
	note = {arXiv:1906.00823 [cs]},
	keywords = {Computer Science - Machine Learning, Electrical Engineering and Systems Science - Signal Processing, Statistics - Machine Learning},
	file = {Full Text PDF:files/1498/Izacard 等 - 2021 - Data-driven Estimation of Sinusoid Frequencies.pdf:application/pdf;Snapshot:files/1499/1906.html:text/html},
}

@article{wang_frequency_2025,
	title = {Frequency {Focus} {Sparse} {Bayesian} {Learning} for {Nonuniform} {Undersampled} {Blade} {Vibration} {Signal} {Parameter} {Identification}},
	volume = {30},
	issn = {1941-014X},
	url = {https://ieeexplore.ieee.org/document/10738478},
	doi = {10.1109/TMECH.2024.3481314},
	abstract = {Rotating blades play a critical role as essential components of aeroengines, and monitoring their operational status is of utmost importance. The blade tip timing (BTT) technique has garnered significant attention due to its noninvasive nature, high reliability, all-blade measurement, and precision. However, the inherent characteristics and working properties of aeroengine blades result in highly undersampled data from BTT probes. Consequently, blade vibration parameter identification has become a significant challenge for the BTT technique. In this article, the frequency focus sparse Bayesian learning with fast marginal likelihood maximization approach is proposed to address this issue. First and foremost, the measured signals are expanded in the frequency domain using a redundant dictionary, and the frequency focus technique is employed to enhance the accuracy of frequency identification while reducing sparse parameters and enhancing sparsity. Second, fast marginal likelihood maximization is harnessed to improve convergence speed while preserving identification accuracy. Finally, the comprehensive simulation and experimental results demonstrate the accuracy and robustness of the proposed method in identifying frequency, magnitude, and phase precisely.},
	number = {5},
	urldate = {2026-06-15},
	journal = {IEEE/ASME Transactions on Mechatronics},
	author = {Wang, Jing and Yang, Laihao and Sun, Yu and Hu, Huahui and Jin, Ruochen and Yang, Zhibo and Yan, Ruqiang and Chen, Xuefeng},
	month = oct,
	year = {2025},
	keywords = {Accuracy, Blade tip timing (BTT), Frequency estimation, Bayes methods, Blades, Dictionaries, fast marginal likelihood maximization (FMLM), parameter identification, Probes, rotating blades, sparse Bayesian learning (SBL), Time-frequency analysis, undersampling, Vectors, Vibration measurement, Vibrations},
	pages = {3630--3640},
	file = {Full Text PDF:files/1502/Wang 等 - 2025 - Frequency Focus Sparse Bayesian Learning for Nonuniform Undersampled Blade Vibration Signal Paramete.pdf:application/pdf},
}

@inproceedings{guo_direction--arrival_2025,
	title = {Direction-of-{Arrival} {Estimation} {Meets} {Machine} {Learning}: {Bridging} {Model}-{Based} {Signal} {Processing} and {Data}-{Driven} {Inference}},
	shorttitle = {Direction-of-{Arrival} {Estimation} {Meets} {Machine} {Learning}},
	url = {https://ieeexplore.ieee.org/document/11382527/},
	doi = {10.1109/ICAICE68195.2025.11382527},
	abstract = {Direction-of-arrival (DOA) estimation is a core problem in array signal processing with applications in wireless sensing, radar, sonar, acoustics, and robotics. Classical subspace and sparse-reconstruction methods enjoy solid theoretical guarantees, yet their performance can deteriorate under model mismatch, limited snapshots, or coherent multipath. In recent years, machine learning (ML) has achieved strong empirical gains by leveraging high-capacity models and large-scale synthetic data. This work reconciles these lines of research: we review the landscape, articulate complementary strengths and limitations, and present a hybrid framework that integrates physics-based priors with learning-based inference. The approach employs covariance-domain representations, deep unfolding, and transformer encoders together with physics-regularized objectives to enhance robustness to array perturbations and domain shift. Simulations across SNR, source coherence, mutual coupling, and calibration error indicate consistent improvements over classical baselines (MUSIC, ESPRIT, SBL) and representative learning-based models, while maintaining interpretability and sample efficiency.},
	urldate = {2026-06-28},
	booktitle = {2025 6th {International} {Conference} on {Artificial} {Intelligence} and {Computer} {Engineering} ({ICAICE})},
	author = {Guo, Yue},
	month = nov,
